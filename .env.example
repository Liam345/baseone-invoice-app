# Database
DATABASE_URL="postgresql://user:password@localhost:5432/invoice_app"

# Supabase (for authentication and file storage)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_KEY="your-service-key"

# Email (Resend)
RESEND_API_KEY="your-resend-api-key"
FROM_EMAIL="noreply@your-domain.com"
REPLY_TO_EMAIL="support@your-domain.com"
EMAIL_DOMAIN="your-domain.com"

# Invoice Security
INVOICE_JWT_SECRET="your-jwt-secret-for-invoice-tokens"

# Background Jobs (Trigger.dev)
TRIGGER_SECRET_KEY="your-trigger-secret-key"
TRIGGER_PROJECT_ID="your-trigger-project-id"

# File Storage
FILE_KEY_SECRET="your-file-encryption-key"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"